{
	"name": "active-user",
	"displayName": "Active User",
	"description": "This extension displays the current VS Code user context in the toolbar",
	"version": "0.0.2",
	"author": {"name":"Eric Buschman"},
	"publisher": "EricBuschman",
	"repository": {"url": "https://github.com/ericbuschman/vscode-active-user"},
	"engines": {
		"vscode": "^1.42.0"
	},
	"categories": [
		"Other"
	],
	"activationEvents": [
		"*"
	],
	"main": "./out/extension.js",
	"contributes": {
		"commands": [
			{
				"command": "statusbar.showCurrentUser",
				"title": "Active User"
			}
		]
	},
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -p ./",
		"lint": "eslint src --ext ts",
		"watch": "tsc -watch -p ./",
		"pretest": "npm run compile && npm run lint",
		"test": "node ./out/test/runTest.js"
	},
	"overrides": {
		"serialize-javascript": "^7.0.5"
	},
	"devDependencies": {
		"@types/mocha": "^10.0.6",
		"@types/node": "^20.11.7",
		"@types/vscode": "^1.42.0",
		"@typescript-eslint/eslint-plugin": "^7.18.0",
		"@typescript-eslint/parser": "^7.18.0",
		"@vscode/test-electron": "^2.3.9",
		"eslint": "^8.57.0",
		"glob": "^10.3.10",
		"mocha": "^10.4.0",
		"typescript": "^5.3.3"
	}
}
